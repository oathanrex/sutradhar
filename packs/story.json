{
  "id": "story",
  "name": "Story / Documentary",
  "aliases": [
    "documentary",
    "true-crime",
    "narrative"
  ],
  "who": "Narrative storytelling, documentary, long-form emotion.",
  "spec_patch": {
    "pacing": {
      "cuts_per_min": 14,
      "avg_shot_len_s": 4.3,
      "max_hold_s": 8.0,
      "motion_per_shot": 1
    },
    "text": {
      "max_chars_per_line": 20,
      "words_on_screen_per_shot": 3.4
    },
    "audio": {
      "sfx_per_min": 3
    }
  },
  "shot_mix": {
    "full": 0.3,
    "words": 0.18,
    "screen": 0.14,
    "flow": 0.1,
    "gif": 0.08,
    "map": 0.08,
    "chat": 0.06,
    "file": 0.06
  },
  "structure": [
    {
      "beat": "coldopen",
      "start_s": 0,
      "target_s": 20,
      "job": "the most dramatic true moment, out of order"
    },
    {
      "beat": "question",
      "start_s": 20,
      "target_s": 20,
      "job": "the question the story answers"
    },
    {
      "beat": "act1",
      "start_s": 40,
      "target_s": 180,
      "job": "ordinary world, one detail that matters"
    },
    {
      "beat": "act2",
      "start_s": 0,
      "target_s": 240,
      "job": "complication, the turn"
    },
    {
      "beat": "act3",
      "start_s": 0,
      "target_s": 180,
      "job": "payoff, emotional peak"
    },
    {
      "beat": "return",
      "start_s": 0,
      "target_s": 40,
      "job": "answer the opening question"
    },
    {
      "beat": "close",
      "start_s": 0,
      "target_s": 15,
      "job": "one quiet line, no CTA scream"
    }
  ],
  "retention_risks": [
    "too many names and dates up front",
    "music carrying emotion the images do not earn",
    "resolution without cost",
    "no reason to keep watching at minute 3"
  ],
  "hook_patterns": [
    "open on the moment, not the beginning",
    "'this is the part nobody believes'",
    "one unresolved question per act"
  ],
  "never": [
    "no fake archive footage",
    "no speculation presented as fact"
  ],
  "gate": {},
  "evidence": [],
  "measured": false,
  "note": "Numbers here are starting defaults chosen from the category's conventions, NOT measurements. Add 3 real videos with `sutra evidence add` before quoting them anywhere."
}
