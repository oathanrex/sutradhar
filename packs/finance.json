{
  "id": "finance",
  "name": "Finance / Money",
  "aliases": [
    "money",
    "investing",
    "business"
  ],
  "who": "Money, markets, personal finance, business breakdowns.",
  "spec_patch": {
    "pacing": {
      "cuts_per_min": 20,
      "avg_shot_len_s": 3.0,
      "max_hold_s": 5.0,
      "motion_per_shot": 1
    },
    "text": {
      "max_chars_per_line": 14,
      "words_on_screen_per_shot": 3.4
    },
    "audio": {
      "sfx_per_min": 5
    }
  },
  "shot_mix": {
    "bars2": 0.2,
    "words": 0.2,
    "screen": 0.18,
    "flow": 0.1,
    "chips": 0.1,
    "full": 0.08,
    "gauge": 0.08,
    "nodes": 0.06
  },
  "structure": [
    {
      "beat": "hook",
      "start_s": 0,
      "target_s": 12,
      "job": "the amount, the loss or the risk"
    },
    {
      "beat": "authority",
      "start_s": 12,
      "target_s": 15,
      "job": "why this is credible, with the source on screen"
    },
    {
      "beat": "explain",
      "start_s": 27,
      "target_s": 150,
      "job": "one number per beat, slowly"
    },
    {
      "beat": "example",
      "start_s": 0,
      "target_s": 90,
      "job": "a real worked example with the maths visible"
    },
    {
      "beat": "risk",
      "start_s": 0,
      "target_s": 45,
      "job": "the downside, stated honestly"
    },
    {
      "beat": "action",
      "start_s": 0,
      "target_s": 20,
      "job": "one concrete next step"
    },
    {
      "beat": "disclaimer",
      "start_s": 0,
      "target_s": 6,
      "job": "required, on screen, readable"
    }
  ],
  "retention_risks": [
    "numbers spoken faster than they can be read",
    "no source on screen",
    "no downside",
    "too much text per card",
    "jargon with no plain-language pair"
  ],
  "hook_patterns": [
    "the amount in rupees/dollars in the first 3 s",
    "'nobody tells you the downside of this'",
    "worked example with the same data as the viewer"
  ],
  "never": [
    "never promise returns",
    "always show the source",
    "never omit the risk"
  ],
  "gate": {
    "require_disclaimer": true,
    "text_contrast_min": 7.0,
    "max_words_on_screen": 6
  }
}
